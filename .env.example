# ---------------------------------------------------------------------------
# mcweb - environment configuration
# Copy this file to .env and fill in real values. NEVER commit .env.
# ---------------------------------------------------------------------------

# App
NODE_ENV=development
APP_URL=http://localhost:3000
PORT=3000

# Security
AUTH_SECRET=change-me-to-a-long-random-string
SESSION_COOKIE_NAME=mcweb_session
SESSION_TTL_SECONDS=2592000

# Database (used by docker-compose + Prisma)
DATABASE_URL=postgresql://mcweb:mcweb@localhost:5432/mcweb?schema=public

# StoreBridge plugin <-> backend secret
STOREBRIDGE_SECRET=change-me-to-a-long-random-string
STOREBRIDGE_TIMEOUT_MS=15000

# Discord OAuth
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_ROLE_BOOST_ID=
# Comma separated role ids to sync on purchase (optional)
DISCORD_SYNC_ROLES=

# Minecraft
MINECRAFT_IP=play.example.com
MINECRAFT_VERSION=1.21.4
# Mojang API base
MOJANG_API=https://api.mojang.com

# Paynow
PAYNOW_ENV=mock            # mock | sandbox | production
PAYNOW_API_KEY=
PAYNOW_API_SECRET=
PAYNOW_GATEWAY_URL=https://api.paynow.pl
PAYNOW_WEBHOOK_TOKEN=

# Server status polling
STATUS_POLL_INTERVAL_SECONDS=30
