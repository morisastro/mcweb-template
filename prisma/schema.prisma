// Prisma schema for mcweb - Minecraft server web platform
// Database: PostgreSQL

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  USER
  STAFF
  ADMIN
  OWNER
}

enum PaymentStatus {
  CREATED
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum DeliveryStatus {
  WAITING
  PROCESSING
  DELIVERED
  FAILED
}

enum PaynowEnv {
  mock
  sandbox
  production
}

enum RewardType {
  DISCORD_LINK
  MC_LINK
  BOTH_LINK
  BOOST
  PLAYTIME
  DAILY
  EVENT
  PROMO_CODE
  MEDIA
  CUSTOM
}

enum MediaPlatform {
  YOUTUBE
  TIKTOK
  TWITCH
  OTHER
}

enum MediaStatus {
  PENDING
  NEEDS_INFO
  APPROVED
  REJECTED
  EXPIRED
}

enum TicketCategory {
  POMOC
  ZAKUP
  BAN_APPEAL
  BUG
  WSPOLPRACA
  INNE
}

enum TicketStatus {
  OPEN
  WAITING_FOR_USER
  WAITING_FOR_STAFF
  CLOSED
}

enum DiscountType {
  PERCENT
  AMOUNT
}

// ---------------------------------------------------------------------------
// Accounts
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  role         Role     @default(USER)
  displayName  String?
  email        String?  @unique
  passwordHash String?  // only for admin password accounts
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  lastLoginAt  DateTime?

  discord     DiscordAccount?
  minecraft   MinecraftAccount?
  sessions    Session[]
  orders      Order[]
  rewardClaims RewardClaim[]
  mediaApps   MediaApplication[]
  tickets     Ticket[]
  deliveryJobs DeliveryJob[]
  couponUsages CouponUsage[]
  auditLogs   AuditLog[]
  adminUser   AdminUser?
  playtimeSec Int     @default(0)

  @@index([role])
}

model DiscordAccount {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  discordId     String   @unique
  username      String
  discriminator String?
  avatarUrl     String?
  accessToken   String
  refreshToken  String?
  tokenExpiresAt DateTime?
  isBooster     Boolean  @default(false)
  roleIds       String[] // synced discord role ids
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([discordId])
}

model MinecraftAccount {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  uuid      String   @unique // dashed mojang uuid
  username  String
  skinUrl   String?
  rank      String?  // minecraft rank label
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([username])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
  @@index([expiresAt])
}

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  userId       String?  @unique // link to a User account if needed
  user         User?    @relation(fields: [userId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model ServerMode {
  id          String   @id @default(cuid())
  slug        String   @unique // boxpvp, survival, lifesteal, skygen
  name        String
  description String?
  icon        String?
  order       Int      @default(0)
  visible     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products    Product[]
  instances   ServerInstance[]
  coupons     Coupon[]
}

model ServerInstance {
  id            String   @id @default(cuid())
  modeId        String
  mode          ServerMode @relation(fields: [modeId], references: [id], onDelete: Cascade)
  name          String   // proxy, boxpvp-1, ...
  host          String
  port          Int      @default(25565)
  online        Boolean  @default(false)
  players       Int      @default(0)
  maxPlayers    Int      @default(0)
  tps           Float?
  mspt          Float?
  pingMs        Int?
  motd          String?
  version       String?
  uptimeSec     Int      @default(0)
  lastRestartAt DateTime?
  storeBridgeOk Boolean  @default(false)
  lastSeenAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  history       UptimeRecord[]

  @@index([modeId])
}

model UptimeRecord {
  id         String   @id @default(cuid())
  instanceId String
  instance   ServerInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  online     Boolean
  players    Int
  tps        Float?
  recordedAt DateTime @default(now())

  @@index([instanceId, recordedAt])
}

model Category {
  id          String   @id @default(cuid())
  slug        String   @unique // rangi, klucze, waluta, przedmioty, pakiety
  name        String
  description String?
  icon        String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]
}

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  price       Decimal  @db.Decimal(12, 2)
  oldPrice    Decimal? @db.Decimal(12, 2)
  icon        String?
  image       String?
  modeId      String
  mode        ServerMode @relation(fields: [modeId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  commands    String[] // executed on delivery, {player} placeholder
  duration    String?  // e.g. "30d"
  featured    Boolean  @default(false)
  active      Boolean  @default(true)
  sort        Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems  OrderItem[]
  coupons     Coupon[] // restricted to this product

  @@index([modeId])
  @@index([categoryId])
  @@index([active])
}

// ---------------------------------------------------------------------------
// Orders & payments
// ---------------------------------------------------------------------------

model Order {
  id          String   @id @default(cuid())
  publicId    String   @unique // short human-readable id
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  email       String?
  playerNick  String   // minecraft nick the purchase is for
  playerUuid  String?
  forOther    Boolean  @default(false) // kup dla innego gracza
  subtotal    Decimal  @db.Decimal(12, 2)
  discount    Decimal  @default(0) @db.Decimal(12, 2)
  total       Decimal  @db.Decimal(12, 2)
  couponId    String?
  coupon      Coupon?  @relation(fields: [couponId], references: [id])
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       OrderItem[]
  payments    Payment[]
  deliveries  DeliveryJob[]

  @@index([userId])
  @@index([createdAt])
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product    Product @relation(fields: [productId], references: [id])
  name       String
  unitPrice  Decimal  @db.Decimal(12, 2) // snapshot from DB at purchase time
  quantity   Int      @default(1)
  commands   String[] // snapshot of commands
  modeId     String
  createdAt  DateTime @default(now())

  @@index([orderId])
}

model Payment {
  id            String        @id @default(cuid())
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider      String        @default("paynow")
  status        PaymentStatus @default(CREATED)
  amount        Decimal       @db.Decimal(12, 2)
  currency      String        @default("PLN")
  paynowId      String?       @unique
  paymentUrl    String?
  idempotencyKey String      @unique
  rawPayload    Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  confirmedAt   DateTime?

  @@index([orderId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Delivery (StoreBridge)
// ---------------------------------------------------------------------------

model DeliveryJob {
  id           String         @id @default(cuid())
  publicId     String         @unique
  orderId      String
  order        Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?          @relation(fields: [userId], references: [id])
  productId    String?
  productName  String
  playerNick   String
  playerUuid   String?
  modeId       String
  commands     String[]
  status       DeliveryStatus @default(WAITING)
  attempts     Int            @default(0)
  lastError    String?
  claimToken   String         @unique //StoreBridge claims by token to prevent double exec
  claimedAt    DateTime?
  deliveredAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([status])
  @@index([orderId])
  @@index([modeId])
}

// ---------------------------------------------------------------------------
// Rewards
// ---------------------------------------------------------------------------

model Reward {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  description String?
  type        RewardType
  icon        String?
  // requirement config stored as json: { minutes: 120 } / { code: "WELCOME" } / { days: 1 }
  requirement Json
  commands    String[]   // minecraft commands executed on claim
  discordRoleIds String[] // discord roles to grant
  claimLimit  Int        @default(1) // how many times a user can claim
  active      Boolean    @default(true)
  order       Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  claims      RewardClaim[]
}

model RewardClaim {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rewardId  String
  reward    Reward   @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  status    String   @default("CLAIMED") // CLAIMED | DELIVERED | FAILED
  progress  Int      @default(0)
  meta      Json?
  createdAt DateTime @default(now())

  @@unique([userId, rewardId])
  @@index([rewardId])
}

// ---------------------------------------------------------------------------
// Media applications
// ---------------------------------------------------------------------------

model MediaApplication {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform     MediaPlatform
  profileUrl   String
  followers    Int           @default(0)
  avgViews     Int           @default(0)
  contentUrl   String
  message      String?
  status       MediaStatus   @default(PENDING)
  expiresAt    DateTime?
  reviewerId   String?
  reviewNote   String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Tickets
// ---------------------------------------------------------------------------

model Ticket {
  id          String         @id @default(cuid())
  publicId    String         @unique
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject     String
  category    TicketCategory
  description String
  status      TicketStatus   @default(OPEN)
  priority    Int            @default(0)
  assignedTo  String?
  discordChannelId String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  closedAt    DateTime?

  messages    TicketMessage[]

  @@index([status])
  @@index([userId])
}

model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String?  // null = system
  authorRole String? // user | staff | system
  body      String
  attachments String[]
  createdAt DateTime @default(now())

  @@index([ticketId])
}

// ---------------------------------------------------------------------------
// Coupons
// ---------------------------------------------------------------------------

model Coupon {
  id          String      @id @default(cuid())
  code        String      @unique
  description String?
  type        DiscountType
  value       Decimal     @db.Decimal(12, 2) // percent (0-100) or amount in PLN
  startsAt    DateTime?
  endsAt      DateTime?
  usageLimit  Int?
  usedCount   Int         @default(0)
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  modes      ServerMode[] // restrict to modes
  products   Product[]   // restrict to products
  orders     Order[]
  usages     CouponUsage[]

  @@index([code])
}

model CouponUsage {
  id        String   @id @default(cuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  orderId   String?
  createdAt DateTime @default(now())

  @@index([couponId])
}

// ---------------------------------------------------------------------------
// Audit log & settings
// ---------------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String
  target    String?
  ip        String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([action])
}

model Setting {
  key       String   @id
  value     String
  public    Boolean  @default(false)
  updatedAt DateTime @updatedAt
}
